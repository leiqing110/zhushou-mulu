---
import { categoryByName } from '../lib/catalog';

interface Props {
  name: string;
  href?: string;
}

const { name, href } = Astro.props;
const meta = categoryByName(name);
const tone = meta?.tone ?? 'slate';
const to = href ?? (meta ? `/categories/${meta.slug}` : undefined);
---

{to ? (
  <a class={`badge tone-${tone}`} href={to}>{name}</a>
) : (
  <span class={`badge tone-${tone}`}>{name}</span>
)}
