---
import { integrationByName } from '../lib/catalog';
import { withBase } from '../lib/paths';

interface Props {
  name: string;
  href?: string | false;
}

const { name, href } = Astro.props;
const meta = integrationByName(name);
const to = href === false ? undefined : href ?? (meta ? withBase(`/integrations/${meta.slug}`) : undefined);
const mark = meta?.mark ?? name.slice(0, 1);
---

{to ? (
  <a class="integ" href={to}>
    <span class="integ-mark" aria-hidden="true">{mark}</span>
    {name}
  </a>
) : (
  <span class="integ">
    <span class="integ-mark" aria-hidden="true">{mark}</span>
    {name}
  </span>
)}
