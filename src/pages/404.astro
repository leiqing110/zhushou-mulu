---
import Layout from '../layouts/Layout.astro';
---

<Layout title="未找到 · 助手目录">
  <div class="wrap">
    <section class="hero">
      <p class="kicker">404</p>
      <h1>这一页不在目录里</h1>
      <p class="lede">也许短名写错了。回到全部助手，或按分类、集成再找一遍。</p>
      <p style="margin-top: 20px;">
        <a class="btn" href="/">返回目录</a>
      </p>
    </section>
  </div>
</Layout>
