---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../lib/catalog';
import { loadBots } from '../../lib/load';
import { withBase } from '../../lib/paths';

const bots = await loadBots();
const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c.name, bots.filter((b) => b.category === c.name).length]),
);
---

<Layout
  title="分类 · 助手目录"
  description="按效率、销售、营销、运营、客成、生活浏览 Grok Bot 现成提示词。"
  current="categories"
>
  <div class="wrap">
    <p class="crumbs"><a href={withBase("/")}>全部助手</a> / 分类</p>
    <section class="page-hero">
      <p class="kicker">按分类浏览</p>
      <h1>六类现成提示词</h1>
      <p class="lede">
        效率、销售、营销、运营、客成、生活。每则提示词都按同一套规矩写：先连接、先询问、先预览，确认后再发出。
      </p>
    </section>
    <div class="grid-3">
      {
        CATEGORIES.map((c) => (
          <a class="card" href={withBase(`/categories/${c.slug}`)}>
            <span class={`badge tone-${c.tone}`}>{c.name}</span>
            <h2>{c.name}</h2>
            <p>{c.blurb}</p>
            <span class="more">{counts[c.name] ?? 0} 则提示词 →</span>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
